    "mode": "PRE_DRAFT_LONG_TAIL_AND_REGIONAL_SERP",
    "required_after_owner_prewrite_confirmation_before_drafting": true,
    "creative_angle_is_not_keyword_evidence": true,
    "variant_priority_order": ["CURRENT_BRAND_SITE", "REGIONAL_SERP", "MODEL_TRANSLATION_FALLBACK"],
    "english_multi_article_intents_must_be_distinct": true,
    "regional_serp_variants_required_for_every_target_language": true,
    "model_translation_fallback_requires_independent_regional_serp_checks": 2,
    "trend_evidence_policy": {
