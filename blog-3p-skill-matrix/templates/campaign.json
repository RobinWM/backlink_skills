  "title_quality_policy": {
    "mode": "MODEL_LED_SEMANTIC_REVIEW",
    "required_before_review": true,
    "review_dimensions": ["topic_clarity", "reader_intent", "distinct_value", "natural_language", "market_suitability"],
    "heuristics": {"minimum_word_count": 6, "minimum_visible_char_count": 24, "non_blocking": true}
  },
  "content_value_policy": {
    "mode": "READER_VALUE_FIRST",
    "primary_purpose": "STANDALONE_ANSWER_TO_READER_TASK",
