# Shipmore directory worker environment example
#
# Copy this file to your preferred runtime env file and fill secrets locally.
# Do not commit real tokens, passwords, auth state files, or encryption keys.

# -----------------------------------------------------------------------------
# Required Shipmore API configuration
# -----------------------------------------------------------------------------

BACKLINK_APP_URL=https://shipmore.app
BACKLINK_AGENT_TOKEN=

# Optional explicit worker identity.
# Leave empty to let managed runtime create/persist one automatically.
BACKLINK_WORKER_ID=
BACKLINK_WORKER_ID_PREFIX=
SHIPMORE_WORKER_INSTANCE_ID=

# -----------------------------------------------------------------------------
# Browser provider
# -----------------------------------------------------------------------------

# Default: ego-browser
BACKLINK_BROWSER_PROVIDER=ego-browser

# Optional local path to ego-browser SKILL.md if runtime discovery is unavailable.
BACKLINK_EGO_BROWSER_SKILL=

# -----------------------------------------------------------------------------
# agent-browser fallback provider
# -----------------------------------------------------------------------------

# Optional encrypted auth seed path, for example:
# C:\Users\wangmeng\.shipmore\shipmore-auth.json.enc
BACKLINK_AGENT_BROWSER_AUTH_STATE=

# Required when using encrypted agent-browser state in production.
# Must be exactly 64 hexadecimal characters.
AGENT_BROWSER_ENCRYPTION_KEY=

AGENT_BROWSER_STATE_EXPIRE_DAYS=36500
AGENT_BROWSER_NAMESPACE=shipmore

# -----------------------------------------------------------------------------
# Directory account authentication
# -----------------------------------------------------------------------------

# Optional runtime-only password used only after OAuth / email auth paths are unavailable.
DIRECTORY_ACCOUNT_PASSWORD=

# -----------------------------------------------------------------------------
# Debug behavior
# -----------------------------------------------------------------------------

# Current default is 1.
# 1 = ignore historical Submission business fields in the worker claim view.
# 0 = use historical Submission lifecycle normally.
# This does NOT disable lease/provider/final-action safety state.
SHIPMORE_DEBUG_IGNORE_HISTORY=1

# -----------------------------------------------------------------------------
# Worker / concurrency
# -----------------------------------------------------------------------------

# Optional Run ID. Can also be passed using --run-id.
SHIPMORE_RUN_ID=

SHIPMORE_CONCURRENCY=4
SHIPMORE_LEASE_SECONDS=300
SHIPMORE_HEARTBEAT_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# Lifecycle cleanup
# -----------------------------------------------------------------------------

SHIPMORE_TERMINAL_STATE_RETENTION_DAYS=7

# Optional local storage path overrides.
# Leave empty to use ~/.shipmore defaults.
SHIPMORE_BROWSER_PROVIDER_LOCK_DIR=
SHIPMORE_FINAL_ACTION_JOURNAL_DIR=
SHIPMORE_LEASE_GUARD_DIR=
SHIPMORE_TERMINAL_SESSION_DIR=
SHIPMORE_WORKER_ID_FILE=
SHIPMORE_WORKER_LOCK_DIR=

# -----------------------------------------------------------------------------
# Managed-runtime internal variables
#
# These are listed for completeness. shipmore_worker.py / shipmore_worker_pool.py
# normally set them automatically. Do not set them manually unless debugging
# the runtime itself.
# -----------------------------------------------------------------------------

SHIPMORE_POOL_SLOT=
SHIPMORE_POOL_SIZE=
SHIPMORE_RUN_ITEM_ID=
SHIPMORE_CLAIM_REASON=
SHIPMORE_RECOVERY_MODE=
SHIPMORE_MANAGED_LEASE=
SHIPMORE_LEASE_GUARD_PATH=
