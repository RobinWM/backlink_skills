# Shipmore 目录提交 Worker 环境变量示例
#
# 使用方式：
# 1. 复制本文件作为你自己的运行时环境配置，例如 .env、worker.env，或手动设置系统环境变量；
# 2. 按需填写下方留空的敏感值和可选路径；
# 3. 不要把真实 Token、密码、Auth State、加密密钥提交到 Git 仓库。
#
# 说明：
# - “默认值”表示代码在该变量未设置时会采用的值；
# - 留空的可选变量通常可以不配置；
# - “内部变量”由 shipmore_worker.py / shipmore_worker_pool.py 自动注入，正常使用时不要手动设置；
# - Windows 路径示例使用反斜杠，例如 C:\Users\wangmeng\.shipmore\...；
# - Linux/macOS 默认本地运行时目录通常位于 ~/.shipmore/。

# =============================================================================
# 一、Shipmore API 基础配置
# =============================================================================

# Shipmore 服务地址。
# 必填。
# 正式环境默认使用 https://shipmore.app。
# 如果你运行的是本地/测试 Shipmore 服务，可以改成对应地址，例如：
# BACKLINK_APP_URL=http://localhost:3000
BACKLINK_APP_URL=https://shipmore.app

# Shipmore Agent API Token。
# 必填，属于敏感信息。
# Worker 使用它调用 claim、heartbeat、complete、outbound-link 等接口。
# 不要把真实 Token 写进仓库，也不要在日志、截图、错误信息中打印它。
BACKLINK_AGENT_TOKEN=

# =============================================================================
# 二、Worker 身份
# =============================================================================

# 当前 Worker 的稳定 ID。
# 可选。
# 如果留空，managed runtime 会自动生成并持久化一个稳定的 worker instance ID。
# 手动设置时应保证：
# - 同一个长期运行的 Worker 尽量保持不变；
# - 多台机器之间不能使用相同 ID；
# - 不要每次启动都随机生成，否则会破坏 lease/recovery 语义。
# 示例：
# BACKLINK_WORKER_ID=shipmore-my-pc-01
BACKLINK_WORKER_ID=

# Worker Pool 的 ID 前缀。
# 可选。
# 主要供 shipmore_worker_pool.py 使用。
# 如果设置为 shipmore-win-dev，则并发 slot 可能生成：
# shipmore-win-dev-01
# shipmore-win-dev-02
# ...
# 多机部署时必须保证前缀全局唯一。
BACKLINK_WORKER_ID_PREFIX=

# 当前宿主机/Worker 实例的持久化身份。
# 可选。
# 留空时默认会从 ~/.shipmore/worker-instance-id 读取或自动创建。
# 一般不需要手动设置，除非你明确需要固定宿主机身份。
SHIPMORE_WORKER_INSTANCE_ID=

# =============================================================================
# 三、浏览器 Provider
# =============================================================================

# 浏览器执行 Provider。
# 当前默认值：ego-browser。
#
# 可选值：
# - ego-browser   ：当前默认路径，优先用于登录、OAuth、账号状态等场景；
# - agent-browser ：备用路径，可显式切换使用。
#
# 注意：
# - Provider 会在 Run Item 开始时被锁定；
# - 同一个 Run Item 中途不能从 ego-browser 切换到 agent-browser，反之亦然；
# - 如果想比较两个 Provider，应创建新的 Run / Run Item。
BACKLINK_BROWSER_PROVIDER=ego-browser

# ego-browser Skill 的本地 SKILL.md 路径。
# 可选。
# 只有运行时无法自动发现 ego-browser Skill 时才需要填写。
# 正常情况下可以留空。
#
# 示例：
# BACKLINK_EGO_BROWSER_SKILL=C:\Users\wangmeng\.agents\skills\ego-browser\SKILL.md
#
# 该路径属于本机运行时信息，不应写入 Shipmore evidence。
BACKLINK_EGO_BROWSER_SKILL=

# =============================================================================
# 四、agent-browser 备用 Provider 配置
# =============================================================================

# agent-browser Auth State 文件路径。
# 可选，仅在使用 agent-browser Provider 时生效。
#
# 这个文件保存从已授权 Chrome Profile 导出的登录状态，
# 用于全新的 Run Item 初始化 Google / GitHub / Gmail 等已授权登录态。
#
# 如果启用了 AGENT_BROWSER_ENCRYPTION_KEY，
# agent-browser 通常会生成 .enc 文件，例如：
# C:\Users\wangmeng\.shipmore\shipmore-auth.json.enc
#
# 注意：
# - 该文件等价于敏感登录凭据；
# - 不要提交 Git；
# - 不要读取、打印、复制其内部 Cookie/localStorage；
# - 已有 Run Item 的 restore state 优先，Auth State 不会覆盖已有恢复状态。
BACKLINK_AGENT_BROWSER_AUTH_STATE=

# agent-browser State 加密密钥。
# 使用 agent-browser 的加密 Auth State / Restore State 时需要。
#
# 要求：
# - 必须是 64 个十六进制字符；
# - 等价于 32 字节 AES-256 密钥；
# - 保存 state 和加载 state 时必须使用同一个值；
# - 属于高敏感信息，不能提交到 Git。
#
# 可以用 Python 生成：
# python -c "import secrets; print(secrets.token_hex(32))"
AGENT_BROWSER_ENCRYPTION_KEY=

# agent-browser 自身的 State 最大年龄安全上限，单位：天。
# 默认值：36500。
#
# 这里故意设置得非常大，避免 agent-browser 按“文件年龄”
# 自动删除仍处于 awaiting_approval、manual verification、recovery 等非终止状态的 session。
#
# 真正的清理由 Shipmore Submission 生命周期控制，而不是单纯按时间清理。
# 一般不要修改。
AGENT_BROWSER_STATE_EXPIRE_DAYS=36500

# agent-browser namespace。
# 默认值：shipmore。
#
# 用于把 Shipmore 相关 session/state 与其他 agent-browser 使用场景隔离。
# 一般不要修改。
AGENT_BROWSER_NAMESPACE=shipmore

# =============================================================================
# 五、目录账号认证
# =============================================================================

# 目录网站的可选邮箱/密码登录密码。
# 可选，属于敏感信息。
#
# 认证顺序通常是：
# 1. 复用已有登录会话；
# 2. Google OAuth；
# 3. GitHub OAuth；
# 4. 邮箱验证码 / magic link；
# 5. 最后才尝试邮箱 + DIRECTORY_ACCOUNT_PASSWORD。
#
# 只有确实需要普通密码登录时才使用该变量。
# 不要把密码打印到日志、Shipmore evidence、截图或命令行参数中。
DIRECTORY_ACCOUNT_PASSWORD=

# =============================================================================
# 六、调试模式
# =============================================================================

# 是否忽略历史 Submission 业务数据。
# 当前默认值：1。
#
# 1 = 调试模式：
#     Worker 在 claim 后会忽略历史业务状态，例如：
#     - submissionStatus
#     - verificationStatus
#     - exactResult
#     - publicListingUrl
#     - route
#     - accountAlias
#     - followUp 信息
#     - 历史检查时间等
#
#     Worker 会从当前网站、当前账号和当前页面重新判断本次结果。
#
# 0 = 正常生命周期模式：
#     Worker 会读取并使用历史 Submission 状态，
#     例如 published / awaiting_approval / blocked_* 等。
#
# 重要：
# - 即使设置为 1，也不会忽略安全状态；
# - lease、reason=claimed/reused、provider lock、browser recovery、
#   final-action journal、completion eventId 仍然有效；
# - 该变量不会删除数据库历史，只改变 Worker 当前看到的 claim 业务视图；
# - complete 仍会把本次结果写回 Shipmore。
#
# 当前处于调试阶段，因此默认保持 1。
SHIPMORE_DEBUG_IGNORE_HISTORY=1

# =============================================================================
# 七、Run / Worker 并发与租约
# =============================================================================

# 当前要处理的 Shipmore Run ID。
# 可选。
# 也可以通过命令行 --run-id 传入。
#
# 例如：
# SHIPMORE_RUN_ID=Hv-k8gq9sGDtW-sDpp_Rm
SHIPMORE_RUN_ID=

# Worker Pool 并发数。
# 默认值：4。
# 最大值由当前代码限制为 16。
#
# 每个并发 slot 会使用独立 Worker ID 和独立 Run Item 浏览器上下文。
# 调试阶段如果希望更容易观察问题，可以临时设为 1。
SHIPMORE_CONCURRENCY=4

# Run Item lease 时长，单位：秒。
# 默认值：300 秒。
#
# Worker claim 成功后，在 lease 有效期内才有权执行可变操作。
# lease 丢失或过期后，mutation guard 会阻止继续写入/提交。
# 一般保持默认值即可。
SHIPMORE_LEASE_SECONDS=300

# Lease heartbeat 间隔，单位：秒。
# 默认值：60 秒。
#
# managed worker 会自动定期 heartbeat，
# 以延长当前 Run Item 的租约。
#
# 该值应明显小于 SHIPMORE_LEASE_SECONDS。
# 默认 60 / 300 的组合通常无需修改。
SHIPMORE_HEARTBEAT_INTERVAL_SECONDS=60

# =============================================================================
# 八、终止状态 Session 清理
# =============================================================================

# 真正进入终止性 Submission 状态后，本地浏览器 session/state
# 继续保留多少天再允许清理。
#
# 默认值：7 天。
#
# 只有明确属于真正终止状态的任务才会进入 cleanup registry，
# 例如 published / unavailable / paid_only / ineligible / rejected 等。
#
# awaiting_approval、awaiting_email_verification、blocked_*、
# submission_outcome_unknown 等仍可能需要后续恢复，因此不会因为 complete 就立即清理。
SHIPMORE_TERMINAL_STATE_RETENTION_DAYS=7

# =============================================================================
# 九、本地运行时目录覆盖
# =============================================================================
#
# 以下变量全部可选。
# 留空时使用 ~/.shipmore 下的默认目录。
#
# 一般不需要设置。
# 只有在以下场景才建议覆盖：
# - CI / 测试需要临时目录；
# - 希望把运行时文件放到指定磁盘；
# - 多套独立 Worker 需要物理隔离本地状态。

# Run Item -> Browser Provider 锁文件目录。
# 用于保证同一个 Run Item 不能中途切换 Provider。
# 默认：~/.shipmore/browser-providers
SHIPMORE_BROWSER_PROVIDER_LOCK_DIR=

# 最终动作 Journal 目录。
# 用于记录 Submit / Publish / Claim / Gmail Send 等最终动作，
# 防止 crash/retry 后重复执行不可逆动作。
# 默认：~/.shipmore/final-actions
SHIPMORE_FINAL_ACTION_JOURNAL_DIR=

# Lease Guard 文件目录。
# LeaseKeeper 会把当前租约可信状态写入这里，
# mutation guard 在可变操作前会检查它。
# 默认：~/.shipmore/lease-guards
SHIPMORE_LEASE_GUARD_DIR=

# Terminal browser session 清理 registry 目录。
# 记录哪些 session 已达到真正可清理生命周期。
# 默认：~/.shipmore/terminal-sessions
SHIPMORE_TERMINAL_SESSION_DIR=

# Worker Instance ID 持久化文件。
# 默认：~/.shipmore/worker-instance-id
# 用于让同一台机器重启后仍保持稳定 Worker 身份。
SHIPMORE_WORKER_ID_FILE=

# Worker 进程锁目录。
# 用于防止同一宿主机上重复启动相同 Worker ID。
# 默认：~/.shipmore/worker-locks
SHIPMORE_WORKER_LOCK_DIR=

# =============================================================================
# 十、Managed Runtime 内部变量
# =============================================================================
#
# 下面这些变量列出来是为了完整说明运行时环境。
#
# 正常情况下：
# - 不要手动设置；
# - shipmore_worker.py / shipmore_worker_pool.py 会根据当前 Run Item 自动注入；
# - 手动伪造这些值可能破坏 lease、recovery、provider lock 或 final-action 安全语义。
#
# 只有在调试 Worker Runtime 本身时才建议直接使用。

# 当前 Worker Pool 的 slot 编号，从 1 开始。
# 例如并发 4 时，值可能是 1 / 2 / 3 / 4。
SHIPMORE_POOL_SLOT=

# 当前 Worker Pool 总 slot 数。
# 通常等于 SHIPMORE_CONCURRENCY。
SHIPMORE_POOL_SIZE=

# 当前已租赁 Run Item 的 ID。
# 由 managed runtime 在 claim 成功后注入。
SHIPMORE_RUN_ITEM_ID=

# 当前 claim 的原因。
# 常见值：
# - claimed：新领取的 Run Item；
# - reused ：同一个 Worker 再次 claim 已持有的 Run Item，用于恢复/处理任务信封。
#
# 该字段属于安全语义，调试模式也不会忽略。
SHIPMORE_CLAIM_REASON=

# 是否处于恢复模式。
# managed runtime 通常根据 SHIPMORE_CLAIM_REASON 自动设置：
# - 1：reused / recovery；
# - 0：全新任务。
#
# fresh-task auth seed 等行为会参考这个值。
SHIPMORE_RECOVERY_MODE=

# 是否由 managed LeaseKeeper 管理租约。
# managed runtime 会设置为 1。
# 当值为 1 时，浏览器 mutation 必须通过 Lease Guard 检查。
SHIPMORE_MANAGED_LEASE=

# 当前 Run Item 的 Lease Guard 文件路径。
# 由 LeaseKeeper 自动生成并注入。
# 浏览器执行可变操作前会读取该文件验证租约是否仍然有效。
SHIPMORE_LEASE_GUARD_PATH=
